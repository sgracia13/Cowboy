+describe("exportAudit", () => {
+  it("returns an empty string for an empty log", async () => {
+    expect(await exportAudit()).toBe("");
+  });
+  it("rejects a zero size", async () => {
+    await expect(exportAudit(0)).rejects.toThrow();
+  });
+});
